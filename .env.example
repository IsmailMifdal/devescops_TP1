# Copier en .env (jamais commité). Aucun secret ici : uniquement des valeurs non sensibles.
# Le mot de passe PostgreSQL est un secret Compose monté par fichier :
#   mkdir -p secrets && openssl rand -hex 24 > secrets/db_password.txt
# Jeton du dépôt de paquets interne (secret de BUILD, monté en tmpfs) :
#   openssl rand -hex 32 > secrets/pip_token
POSTGRES_USER=testuser
POSTGRES_DB=testdb
